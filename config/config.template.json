{
    "file_paths": {
        "data_dir": "data/",
        "original_file": "data/decisions.json",
        "working_file": "data/vocabulary_data.json",
        "exposure_file": "data/exposure_data.json",
        "pause_file": "data/pause_data.json",
        "backup_file": "data/backup_decisions.json",
        "log_file": "logs/daily_generator.log",
        "constructions_file": "data/constructions_master.json",
        "construction_fit_log_file": "data/construction_fit_log.json",
        "output_session_file": "data/output_session.json",
        "output_chat_file": "data/output_chat.json",
        "rule_ranking_file": "data/rule_ranking.json",
        "rule_state_file": "data/rule_state.json",
        "error_patterns_file": "data/error_patterns.json",
        "drill_pool_file": "data/drill_pool.json"
    },
    "api_settings": {
        "openwebui_url": "http://localhost:3000",
        "openwebui_api_key": null,
        "model": "deepseek-chat",
        "temperature": 0.7,
        "max_tokens": 400,
        "timeout": 60,
        "rate_limit_seconds": 0.5
    },
    "drill_settings": {
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat",
        "temperature": 0.8,
        "max_tokens": 400,
        "timeout": 40,
        "api_key_env": "DEEPSEEK_API_KEY"
    },
    "chat_settings": {
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat",
        "temperature": 0.6,
        "max_tokens": 800,
        "timeout": 40,
        "api_key_env": "CHAT_API_KEY"
    },
    "srs_settings": {
        "new_cards_per_day": 10,
        "learning_steps_minutes": [1, 10, 30],
        "graduating_interval_days": 1,
        "easy_interval_days": 4,
        "starting_ease": 2.5,
        "easy_bonus": 1.3,
        "interval_modifier": 1.0,
        "hard_interval_multiplier": 1.2,
        "min_ease_factor": 1.3,
        "max_ease_factor": 3.0,
        "leech_threshold": 8,
        "leech_action": "suspend",
        "max_reviews_per_day": null,
        "review_order": "overdue_first"
    },
    "urgency_settings": {
        "time_weight": 0.7,
        "exposure_weight": 0.3,
        "max_days_between_exposures": 40,
        "min_days_between_exposures": 14,
        "target_exposures_per_word": 10,
        "learning_bonus": 0.3,
        "lapse_bonus": 0.2,
        "overdue_bonus": 0.1,
        "phase_1_days": 42
    },
    "sentence_settings": {
        "practice_words_per_sentence": 15,
        "cefr_level": "C1",
        "max_sentence_words": 15,
        "min_sentence_words": 10,
        "max_sentences_per_word": 10,
        "include_translation": true,
        "include_practice_words_used": true,
        "generate_for_review_cards": false,
        "regenerate_after_days": 90
    },
    "construction_settings": {
        "enabled": true,
        "new_per_day": 2,
        "slots_per_new_construction": 10,
        "rotation_alpha": 1.0,
        "anti_cluster_window": 10,
        "slot_jitter_min": 3,
        "slot_jitter_max": 5,
        "gloss_max_chars": 200
    },
    "output_settings": {
        "enabled": true,
        "default_mode": "loop",
        "default_grammar_scope": "a1",
        "default_vocab_scope": "a1",
        "default_buffer": 5,
        "max_buffer": 20,
        "generator": {
            "base_url": "https://api.deepseek.com/v1",
            "model": "deepseek-chat",
            "temperature": 0.9,
            "max_tokens": 400,
            "timeout": 60,
            "api_key_env": "DEEPSEEK_API_KEY"
        },
        "chat": {
            "base_url": "https://api.deepseek.com/v1",
            "model": "deepseek-chat",
            "temperature": 0.2,
            "max_tokens": 1200,
            "timeout": 60,
            "api_key_env": "DEEPSEEK_API_KEY"
        }
    },
    "pause_settings": {
        "enabled": true,
        "auto_pause_after_days": 1,
        "catch_up_mode": "gradual",
        "max_catch_up_per_day": 50
    },
    "logging": {
        "level": "INFO",
        "log_file": "logs/daily_generator.log",
        "console_output": true,
        "detailed_logging": false
    }
}
